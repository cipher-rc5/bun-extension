#!/usr/bin/env sh
# pre-commit: scan staged changes for secrets with gitleaks.
# Wired via `core.hooksPath = .githooks` (run `bun run prepare` to enable).

if command -v gitleaks >/dev/null 2>&1; then
  # `git --staged` scans only the staged diff (fast, pre-commit scoped) and
  # honors .gitleaks.toml. --redact keeps any found secret out of the output.
  if ! gitleaks git --staged --redact --no-banner; then
    echo ''
    echo 'gitleaks: potential secret detected in staged changes — commit blocked.'
    echo 'Remove the secret, or if it is a verified false positive add a rule/allowlist'
    echo 'to .gitleaks.toml. To bypass once (NOT recommended): git commit --no-verify'
    exit 1
  fi
else
  echo 'gitleaks not installed — skipping secret scan.'
  echo 'Install it to enable pre-commit secret scanning: brew install gitleaks'
  echo '(see readme "Security / secret scanning")'
fi

exit 0
