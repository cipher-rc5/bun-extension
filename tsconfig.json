{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "react": ["./node_modules/preact/compat/src/index"],
      "react-dom": ["./node_modules/preact/compat/src/index"],
      "react-dom/client": ["./node_modules/preact/compat/client"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime/src/index"]
    },
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["chrome"]
  },
  "include": ["src/**/*", "build/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
