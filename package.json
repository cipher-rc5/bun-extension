{
  "name": "bun-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Chromium extension built with Preact, TypeScript, Tailwind CSS, and Bun",
  "type": "module",
  "module": "src/background/index.ts",
  "scripts": {
    "build": "bun run build/build-all.ts",
    "build:css": "bun run build/build-css.ts",
    "build:extension": "bun build ./src/popup/index.tsx --outdir ./dist --target browser --minify --entry-naming index.js",
    "build:content": "bun build ./src/content/index.ts --outdir ./dist --target browser --minify --entry-naming content.js",
    "build:background": "bun build ./src/background/index.ts --outdir ./dist --target browser --minify --entry-naming background.js",
    "copy:assets": "bun run build/copy-assets.ts",
    "generate:icons": "bun run build/generate-icons.ts",
    "dev": "bun run build/dev.ts",
    "clean": "bun run build/clean.ts",
    "type-check": "bun --bun run tsc --noEmit",
    "test": "bun test ./tests",
    "bench:text": "bun run build/benchmark.ts",
    "format": "bun --bun run dprint fmt",
    "lint": "bun run check:bun && bun --bun run dprint check",
    "check:bun": "bun run build/check-toolchain.ts",
    "scan:secrets": "bun run build/scan-secrets.ts",
    "hooks:install": "bun run build/install-hooks.ts",
    "prepare": "bun run build/install-hooks.ts --optional",
    "browser:install": "bun --bun run playwright install chromium",
    "browser:install:compat": "bun run build/install-compat-browser.ts",
    "test:browser": "bun --bun run playwright test --project chromium",
    "release:check": "bun run build/check-release.ts",
    "release:package": "bun run build/release-artifacts.ts package",
    "release:checksums": "bun run build/release-artifacts.ts checksums",
    "release:bundle": "bun run build/release-artifacts.ts bundle",
    "test:compat": "bun --bun run playwright test --project chromium-111"
  },
  "dependencies": { "preact": "11.0.1" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/oxide": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/chrome": "0.3.5",
    "dprint": "0.63.0",
    "lightningcss": "1.32.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": { "bun": ">=1.4.3" }
}
